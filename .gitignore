# Godot binary (download per the setup docs, don't commit)
Godot_v4.7.2-stable_linux.x86_64
*.zip
*.tpz

# Godot editor cache (regenerated on open)
.godot/

# WASM export output (ephemeral, regenerate with the export command)
export/

# Screenshot iteration artifacts
test_screenshot.png
test_screenshot.png.import
test_frame.wav
test_frame.wav.import
core.*

# Large intermediate data (the raw Census zip; keep extracted source + final build)
packs/*/pipeline/raw/*.zip

# Godot auto-generates .translation from CSVs; we keep CSVs as plain data (importer=keep)
*.translation

# Browser verification screenshot (ephemeral)
browser_screenshot.png
browser_screenshot.png.import
browser_click.png
browser_click.png.import
browser_capitals.png
browser_capitals.png.import
browser_states.png
browser_states.png.import

# A global ~/.gitignore "build" pattern would drop pack build pipelines; keep them.
!packs/*/pipeline/
!packs/*/pipeline/**
browser_menu.png
browser_menu.png.import
browser_picker.png
browser_picker.png.import
